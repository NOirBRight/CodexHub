+
+test("read-only admin status requires the service credential and reports configured Web routes", async () => {
+  const config = { ...defaultConfig("browser-only"), port: 0 };
+  config.solAvailable = false;
+  const server = startServer(config);
+  const endpoint = `http://127.0.0.1:${server.port}`;
+  const headers = { authorization: `Bearer ${config.controlToken}` };
+
+  try {
+    expect((await fetch(`${endpoint}/admin/status`)).status).toBe(401);
+    expect((await fetch(`${endpoint}/admin/status`, { headers: { authorization: "Bearer wrong" } })).status).toBe(401);
+
+    const response = await fetch(`${endpoint}/admin/status`, { headers });
+    expect(response.status).toBe(200);
+    const body = await response.json() as {
+      control_contract_version: number;
+      status: string;
+      accepting_turns: boolean;
+      active_http_turns: number;
+      active_browser_turns: number;
+      account_capabilities: { sol_available: boolean };
+      models: Array<{ id: string; display_name: string; efforts: string[]; image_input: boolean }>;
+    };
+    expect(body).toMatchObject({
+      control_contract_version: 1,
+      status: "ok",
+      accepting_turns: true,
+      active_http_turns: 0,
+      active_browser_turns: 0,
+      account_capabilities: { sol_available: false },
+    });
+    expect(body.models).toEqual(availableChatGptWebModelRoutes(config, true).map(route => ({
+      id: route.slug,
+      display_name: route.displayName,
+      efforts: [...chatGptWebRouteEfforts(route, config)],
+      image_input: route.interactionMode === "automatic",
+    })));
+    expect(JSON.stringify(body)).not.toContain(config.controlToken);
+  } finally {
+    await server.stop(true);
+  }
+});
+
+test("the service credential authorizes Web Responses and is rejected before native passthrough", async () => {
+  const config = { ...defaultConfig("browser-only"), port: 0 };
+  let adapterCalls = 0;
+  const upstreamAuthorizations: string[] = [];
+  const server = startServer(config, {
+    fetchUpstream: async request => {
+      upstreamAuthorizations.push(request.headers.get("authorization") ?? "");
+      return Response.json({ id: "native-response", status: "completed", output: [] });
+    },
+    adapterFactory: () => {
+      adapterCalls += 1;
+      return {
+        name: "control-contract-test",
+        runTurn: async (_request, _context, emit) => {
+          emit({ type: "text_delta", text: "ok", phase: "final_answer" });
+        },
+      };
+    },
+  });
+  const endpoint = `http://127.0.0.1:${server.port}`;
+  const webBody = JSON.stringify({
+    model: "chatgpt-web/high",
+    stream: false,
+    input: [{ type: "message", role: "user", content: [{ type: "input_text", text: "hello" }] }],
+  });
+  const nativeBody = JSON.stringify({ model: "gpt-5.6-sol", input: [] });
+  const serviceHeaders = { "content-type": "application/json", authorization: `Bearer ${config.controlToken}` };
+
+  try {
+    const deniedWeb = await fetch(`${endpoint}/v1/responses`, {
+      method: "POST", headers: { "content-type": "application/json" }, body: webBody,
+    });
+    expect(deniedWeb.status).toBe(401);
+    expect(adapterCalls).toBe(0);
+
+    const allowedWeb = await fetch(`${endpoint}/v1/responses`, {
+      method: "POST", headers: serviceHeaders, body: webBody,
+    });
+    expect(allowedWeb.status).toBe(200);
+    expect(adapterCalls).toBe(1);
+    expect(upstreamAuthorizations).toEqual([]);
+
+    const deniedNative = await fetch(`${endpoint}/v1/responses`, {
+      method: "POST", headers: serviceHeaders, body: nativeBody,
+    });
+    expect(deniedNative.status).toBe(401);
+    expect(upstreamAuthorizations).toEqual([]);
+
+    for (const [path, body] of [
+      ["/v1/models", undefined],
+      ["/v1/responses/compact", nativeBody],
+      ["/v1/alpha/search", JSON.stringify({ query: "private" })],
+      ["/v1/images/generations", JSON.stringify({ prompt: "private" })],
+    ] as const) {
+      const response = await fetch(`${endpoint}${path}`, {
+        method: path === "/v1/models" ? "GET" : "POST",
+        headers: serviceHeaders,
+        ...(body === undefined ? {} : { body }),
+      });
+      expect(response.status).toBe(401);
+    }
+    expect(upstreamAuthorizations).toEqual([]);
+  } finally {
+    await server.stop(true);
+  }
+});
